// part: metadata

[setup]
drop = "test_timestamp"

[tags]
sql-type-name = "TIMESTAMP(p) (1 <= p <= 3)"
field-type-name = "TIMESTAMP(3)"

// part: setup_query

CREATE TABLE test_timestamp (
    idx INTEGER,
    res TIMESTAMP(3)
);

INSERT INTO test_timestamp (idx, res) VALUES (1, TIMESTAMP '2023-05-15 13:45:30.123');
INSERT INTO test_timestamp (idx, res) VALUES (2, TIMESTAMP '2000-01-01 00:00:00.234');
INSERT INTO test_timestamp (idx, res) VALUES (3, TIMESTAMP '1969-07-20 20:17:40.345');
INSERT INTO test_timestamp (idx, res) VALUES (4, TIMESTAMP '0001-01-01 00:00:00.000');
INSERT INTO test_timestamp (idx, res) VALUES (5, TIMESTAMP '9999-12-31 23:59:59.999');
INSERT INTO test_timestamp (idx, res) VALUES (6, NULL);

// part: query

SELECT res FROM test_timestamp ORDER BY idx

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tsm:",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": 1684158330123}
{"res": 946684800234}
{"res": -14182939655}
{"res": -62135596800000}
{"res": 253402300799999}
{"res": null}
