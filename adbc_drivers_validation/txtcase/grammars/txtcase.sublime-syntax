---
name: TxtCase
version: 2
file_extensions: [txtcase]
scope: source.txtcase

variables:
  part_start: '^(//\s*)(part:)\s*'
  part_end: '[\s-]*$'
  part_header: '{{part_start}}\w+{{part_end}}'

contexts:
  main:
    - match: '{{part_start}}(metadata){{part_end}}'
      captures:
        1: punctuation.definition.comment.txtcase
        2: keyword.control.part.txtcase
        3: entity.name.section.metadata.txtcase
      push: metadata
    - match: '{{part_start}}(query|setup_query|bind_query){{part_end}}'
      captures:
        1: punctuation.definition.comment.txtcase
        2: keyword.control.part.txtcase
        3: entity.name.section.sql.txtcase
      push: sql
    - match: '{{part_start}}(bind_schema|execute_schema|expected_schema|catalog_schema|input_schema){{part_end}}'
      captures:
        1: punctuation.definition.comment.txtcase
        2: keyword.control.part.txtcase
        3: entity.name.section.schema.txtcase
      push: json
    - match: '{{part_start}}(bind|expected|input){{part_end}}'
      captures:
        1: punctuation.definition.comment.txtcase
        2: keyword.control.part.txtcase
        3: entity.name.section.data.txtcase
      push: json
    - match: '{{part_start}}(\w+){{part_end}}'
      captures:
        1: punctuation.definition.comment.txtcase
        2: keyword.control.part.txtcase
        3: entity.name.section.txtcase
    - include: comments

  comments:
    - match: '^(//).*$'
      scope: comment.line.double-slash.txtcase
      captures:
        1: punctuation.definition.comment.txtcase

  section-boundary:
    - match: '(?={{part_header}})'
      pop: true
    - include: comments

  # Return to the section context for every txtcase comment, including headers.
  # This also recognizes boundaries inside unfinished embedded strings.
  metadata:
    - include: section-boundary
    - match: '(?=\S)'
      embed: scope:source.toml
      embed_scope: meta.embedded.toml.txtcase
      escape: '^(?=//)'

  sql:
    - include: section-boundary
    - match: '(?=\S)'
      embed: scope:source.sql
      embed_scope: meta.embedded.sql.txtcase
      escape: '^(?=//)'

  json:
    - include: section-boundary
    - match: '(?=\S)'
      embed: scope:source.json
      embed_scope: meta.embedded.json.txtcase
      escape: '^(?=//)'
